        },
        "el" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Το SimBuddy ελέγχει κάθε λίγα δευτερόλεπτα αν έχει εκκινηθεί ή τερματιστεί κάποιος προσομοιωτής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
