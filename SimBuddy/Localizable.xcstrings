    "O SimBuddy verifica a cada poucos segundos se algum simulador foi iniciado ou encerrado." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SimBuddy проверява на всеки няколко секунди дали някой симулатор е стартиран или изключен."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SimBuddy kontrollerer hvert par sekunder, om en simulator er blevet startet eller afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "SimBuddy prüft alle paar Sekunden, ob ein Simulator gestartet oder beendet wurde."
